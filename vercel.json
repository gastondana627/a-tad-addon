{
  "buildCommand": "npm run build:netlify",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/*.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    { "source": "/api/brand",       "destination": "/api/brand.py" },
    { "source": "/api/process-url", "destination": "/api/process-url.py" },
    { "source": "/api/chat",        "destination": "/api/chat.py" },
    { "source": "/((?!api/).*)",    "destination": "/index.html" }
  ]
}
